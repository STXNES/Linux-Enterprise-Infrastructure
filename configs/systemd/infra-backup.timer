[Unit]
Description=Daily Trigger for Enterprise Infrastructure Encrypted Backup
Documentation=https://github.com/STXNES/linux-enterprise-infrastructure
RefuseManualStart=no
RefuseManualStop=no

[Timer]
# Run every day at 02:00:00 UTC
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=120
Persistent=true
Unit=infra-backup.service

[Install]
WantedBy=timers.target
